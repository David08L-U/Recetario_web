# Copia este archivo como .env y pon tus claves reales
SPOONACULAR_API_KEY=tu_api_key_aqui
PORT=3000

# --- Traducción (elige UNA opción, ambas son opcionales) ---
# Opción A (sin registro): MyMemory. Pon tu correo para subir el límite
# gratis de ~5,000 a ~50,000 caracteres al día.
MYMEMORY_EMAIL=

# Opción B (mejor calidad): DeepL API Free (500,000 caracteres/mes).
# Si la pones, se usa DeepL en lugar de MyMemory.
DEEPL_API_KEY=
